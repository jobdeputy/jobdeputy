{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideAllowedRegion",
      "Effect": "Deny",
      "NotAction": [
        "account:*",
        "acm:*",
        "aws-portal:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cloudfront:*",
        "cur:*",
        "health:*",
        "iam:*",
        "organizations:*",
        "pricing:*",
        "route53:*",
        "s3:GetAccountPublicAccessBlock",
        "s3:ListAllMyBuckets",
        "sso:*",
        "sts:*",
        "support:*",
        "tag:*",
        "trustedadvisor:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:RequestedRegion": ["__REGION__"] }
      }
    }
  ]
}
