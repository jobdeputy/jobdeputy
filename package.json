{
  "name": "jobdeputy",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "synth": "pnpm --filter @jobdeputy/infra synth",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "test:integration": "pnpm --filter @jobdeputy/integration-tests test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
