{
  "config": {
    "default": true,
    "MD013": false, // line length: prose is not wrapped
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["details", "summary"] },
    "MD041": false, // PR template starts with an H2 by design
    "MD060": false // table pipe alignment is cosmetic
  },
  "ignores": ["**/node_modules/**", "**/cdk.out/**"]
}
